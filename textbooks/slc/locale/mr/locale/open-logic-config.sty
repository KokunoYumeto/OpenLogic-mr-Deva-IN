\renewcommand*{\article}[1]{}
\renewcommand*{\Article}[1]{}
% Keep the two OLP switches, and leave whitespace or a Marathi suffix to the module.
\expandafter\RenewDocumentCommand\csname @printtoken\endcsname{t^ ta m !ts !td}{%
  \IfBooleanTF{#5}
    {\IfBooleanTF{#1}{\printtoken{D}{#3}}{\printtoken{d}{#3}}}
    {\IfBooleanTF{#1}
       {\IfBooleanTF{#4}{\printtoken{P}{#3}}{\printtoken{S}{#3}}}
       {\IfBooleanTF{#4}{\printtoken{p}{#3}}{\printtoken{s}{#3}}}}}

% Text labels in proof diagrams. The operators and optional indices stay in math.
\RenewDocumentCommand \Intro { m o }{%
  \ensuremath{{#1}\,\text{प्र.}\IfNoValueF{#2}{_{#2}}}}
\RenewDocumentCommand \Elim { m o }{%
  \ensuremath{{#1}\,\text{वि.}\IfNoValueF{#2}{_{#2}}}}
\RenewDocumentCommand \LeftR { m }{\ensuremath{{#1}\,\text{डा.}}}
\RenewDocumentCommand \RightR { m }{\ensuremath{{#1}\,\text{उ.}}}
\DeclareDocumentMacro \Weakening {\ensuremath{\text{दु.}}}
\DeclareDocumentMacro \Contraction {\ensuremath{\text{आ.}}}
\DeclareDocumentMacro \Exchange {\ensuremath{\text{अ.}}}
\DeclareDocumentMacro \Cut {\ensuremath{\text{कट}}}
\DeclareDocumentMacro \Hyp {\ensuremath{\text{गृहीतक}}}
\DeclareDocumentMacro \TAss {\text{गृहीतक}}

\RenewDocumentCommand \indcase { s t{!} m m +m }{%
  \DeclareDocumentMacro \indfrm {#3}%
  \DeclareDocumentMacro \indfrmp {#3}%
  \DeclareDocumentMacro \indcomplex {#4}%
  \IfBooleanTF{#1}{$#3$ हे अणुसूत्र आहे. }{$#3 \ident #4$: }%
  \IfBooleanTF{#2}{हा भाग सरावासाठी.}{#5}}

