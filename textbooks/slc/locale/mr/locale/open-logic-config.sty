% Marathi text tokens. The OLP token and variant keys are stable.
% Marathi does not distinguish upper and lower case or use an indefinite article.
\newcommand*{\mrsettexttoken}[3]{%
  \settexttoken{#1}{#2}{#3}[#2][#3]%
  \definetoken{a}{#1}{}%
  \definetoken{A}{#1}{}}
\newcommand*{\mrsettokenoblique}[3]{%
  \definetoken{oblique}{#1}{#2}%
  \definetoken{oblique plural}{#1}{#3}}

