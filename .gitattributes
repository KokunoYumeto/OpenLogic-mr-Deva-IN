# Preserve frozen source and artifact bytes across platforms.
* -text

# Release TeX is the exact assembled build input; mixed indentation can occur
# inside preserved tabular source and must not be rewritten after PDF binding.
releases/*/*.tex whitespace=cr-at-eol,-space-before-tab,-blank-at-eof

# Generated release metadata retains its exact Windows line endings.
releases/*/*.json whitespace=cr-at-eol
releases/*/*.md whitespace=cr-at-eol,-blank-at-eof
releases/*/*.txt whitespace=cr-at-eol

# Generated review snapshots preserve CRLF and Markdown's intentional hard breaks.
provenance/** whitespace=cr-at-eol
provenance/*.md whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
provenance/translation-decisions/*.md whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
